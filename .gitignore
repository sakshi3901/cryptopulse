```gitignore
# Python cache
Backend/**/__pycache__/
Backend/**/*.pyc
Backend/**/*.pyo

# Python virtual environment
Backend/venv/
Backend/.venv/

# Environment variables
Backend/.env
Backend/.env.*
Frontend/.env
Frontend/.env.*

# Node
Frontend/node_modules/

# Frontend build
Frontend/dist/
Frontend/build/
Frontend/.vite/

# Logs
*.log

# Redis
*.rdb

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
```
